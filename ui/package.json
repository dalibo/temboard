  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.16.6",
    "datatables.net-bs5": "^3.1.3",
    "datatables.net-buttons-bs5": "^4.1.2",
    "datatables.net-vue3": "^3.0.8",
    "daterangepicker": "^3.1.0",
    "dygraphs": "^2.2.2",
    "filesize": "^11.0.26",
    "highlight.js": "^11.12.0",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "pev2": "^1.24.0",
    "vue": "^3.4.21",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
